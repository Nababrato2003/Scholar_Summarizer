# ==============================================================================
# ScholarCritic Environment Variables Template
# Copy this file to .env and fill in your actual credentials
# ==============================================================================

# Google Gemini API Key (Get free at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Atlas Connection URI (Free M0 cluster from https://www.mongodb.com/atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Dedicated MongoDB Atlas URI for PDF File Storage & History (From second account)
MONGO_STORAGE_URI=mongodb+srv://<username>:<password>@cluster1.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Gmail SMTP Configuration for Email OTP Verification
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail_address@gmail.com
# 16-character Google App Password (Generate at https://myaccount.google.com/apppasswords)
MAIL_PASSWORD=your_16_character_app_password
